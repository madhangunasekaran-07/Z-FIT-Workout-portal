# Environment Configuration for Z Fit

PROJECT_NAME="Z Fit Workout Portal"
ENVIRONMENT=development
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Connection:
# For local development, defaults to SQLite:
DATABASE_URL="sqlite:///./zfit.db"
# For PostgreSQL in production, set e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/zfit_db"

ADMIN_EMAIL="admin@zfit.com"
ADMIN_PASSWORD="Admin@123"
